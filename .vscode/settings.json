// Place your settings in this file to overwrite default and user settings.
{
  // Configure glob patterns for excluding files and folders in the file explorer.
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/bower_components": true,
    "**/coverage": true,
    "**/jest-output": true,
    "**/lib-amd": true,
    "src/**/*.scss.ts": true
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  // SPFx Local Workbench extension: serve via mise so Heft runs on the pinned Node 22,
  // whatever Node the user's shell provides
  "spfxLocalWorkbench.serveCommand": "mise exec -- npx heft start --clean --nobrowser"
}