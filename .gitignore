# OS / editor
.DS_Store

# Claude Code — machine-local settings & audit artifacts (never commit)
.claude/settings.local.json
AUDIT-RESULTS.md

# Env files — only the example is tracked
.env*
!.env.example

# Private material (see private/README.md)
private/*
!private/README.md

# module:gitignore — stack module entries are appended below
# spfx module (SharePoint Framework 1.23, Heft toolchain)
# Anchored to the repo root — an unanchored `lib/` would also hide e.g. src/lib/
/node_modules/
/logs/
*.log
/dist/
/lib/
/lib-dts/
/lib-commonjs/
/lib-esm/
/jest-output/
/release/
/temp/
/sharepoint/solution/
*.sppkg
/.heft/
/coverage/
# generated typings for SCSS modules and resx
*.scss.ts
*.resx.ts
