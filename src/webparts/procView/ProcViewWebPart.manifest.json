{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "0253008c-46f4-4e61-b423-57d13df20000",
  "alias": "ProcViewWebPart",
  "componentType": "WebPart",

  // The "*" signifies that the version should be taken from the package.json
  "version": "*",
  "manifestVersion": 2,

  // If true, the component can only be installed on sites where Custom Script is allowed.
  // Components that allow authors to embed arbitrary script code should set this to true.
  // https://support.office.com/en-us/article/Turn-scripting-capabilities-on-or-off-1f2c515f-5d7e-448a-9fd7-835da935584f
  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "TeamsPersonalApp", "TeamsTab", "SharePointFullPage"],
  "supportsThemeVariants": true,

  "preconfiguredEntries": [
    {
      "groupId": "1bc7927e-4a5e-4520-b540-71305c79c20a", // Planning and process
      // "group" only affects the classic picker; modern pages show SharePoint's own
      // localised name of the predefined groupId
      "group": {
        "default": "Planning and process",
        "de-DE": "Planung und Prozess",
        "fr-FR": "Planification et processus",
        "es-ES": "Planificación y procesos"
      },
      "title": {
        "default": "Process diagram (ProcView)",
        "de-DE": "Prozessdiagramm (ProcView)",
        "fr-FR": "Diagramme de processus (ProcView)",
        "es-ES": "Diagrama de procesos (ProcView)"
      },
      "description": {
        "default": "Embeds a process diagram (SAP Signavio) with adjustable size.",
        "de-DE": "Bindet ein Prozessdiagramm (SAP Signavio) in einstellbarer Größe ein.",
        "fr-FR": "Intègre un diagramme de processus (SAP Signavio) de taille réglable.",
        "es-ES": "Inserta un diagrama de procesos (SAP Signavio) de tamaño ajustable."
      },
      "officeFabricIconFontName": "VisioDiagram",
      // Initial values — they must match the fallbacks in the code (ProcViewWebPart.ts,
      // renderDiagram.ts) so the property pane shows the defaults as selected
      "properties": {
        "captionAlign": "center",
        "showHubLink": false,
        "hubLinkPosition": "below",
        "hubLinkAlign": "right"
      }
    }
  ]
}
